# Copy to .env (gitignored) and fill in. These are bundled into the browser build, so only
# public values belong here: never a service-role key or the JWT secret.

# The shared Legacy Supabase project (not the old Bolt project).
VITE_SUPABASE_URL=https://your-shared-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Entra ID app registration the GC app signs in with (SPA platform, redirect URI = the app's URL).
VITE_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
